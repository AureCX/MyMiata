<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".IRRemoteActivity">

    <ImageButton
        android:id="@+id/button_power"
        android:layout_width="175dp"
        android:layout_height="183dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_power"
        android:src="@drawable/button_power" />

    <Button
        android:id="@+id/button_speed_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="192dp"
        android:layout_marginTop="363dp"
        android:layout_marginEnd="10dp"
        android:layout_toEndOf="@+id/button_demo"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_speed_plus"
        android:text="@string/button_speed_plus" />

    <Button
        android:id="@+id/button_mode_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_mode_plus"
        android:layout_toEndOf="@id/button_mode_plus"
        android:layout_below="@id/button_power"
        android:layout_marginStart="16dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_mode_plus" />

    <Button
        android:id="@+id/button_speed_minus"
        android:layout_width="64dp"
        android:layout_height="60dp"
        android:layout_below="@id/button_power"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_toEndOf="@id/button_mode_plus"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_speed_minus"
        android:text="@string/button_speed_minus" />

    <!-- Add color buttons here in a similar fashion -->

    <!-- Add the back button -->

    <Button
        android:id="@+id/button_color_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="313dp"
        android:layout_marginEnd="121dp"
        android:layout_toStartOf="@+id/button_demo"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_color_plus"
        android:text="@string/button_color_plus"
        tools:ignore="RelativeOverlap" />

    <Button
        android:id="@+id/button_demo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_mode_plus"
        android:layout_marginTop="371dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_demo"
        android:text="@string/button_demo" />

    <Button
        android:id="@+id/button_mode_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/button_demo"
        android:layout_alignParentStart="true"
        android:layout_marginStart="110dp"
        android:layout_marginTop="107dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_mode_minus"
        android:text="@string/button_mode_minus" />

    <Button
        android:id="@+id/button_color_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_color_plus"
        android:layout_alignParentStart="true"
        android:layout_marginStart="34dp"
        android:layout_marginTop="408dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_color_minus"
        android:text="@string/button_color_minus"
        tools:ignore="ImageContrastCheck" />

    <Button
        android:id="@+id/button_bright_plus"
        android:layout_width="123dp"
        android:layout_height="46dp"
        android:layout_below="@+id/button_speed_plus"
        android:layout_marginStart="58dp"
        android:layout_marginTop="62dp"
        android:layout_toEndOf="@+id/button_mode_minus"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_bright_plus"
        android:text="@string/button_bright_plus" />

    <Button
        android:id="@+id/button_bright_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/button_bright_plus"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="9dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_bright_minus"
        android:text="@string/button_bright_minus" />

    <Button
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="66dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="0dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_back"
        android:text="@string/x"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="24sp"
        tools:ignore="RelativeOverlap,TouchTargetSizeCheck" />

</RelativeLayout>
