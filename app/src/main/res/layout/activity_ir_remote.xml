<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".IRRemoteActivity">

    <ImageButton
        android:id="@+id/button_power"
        android:layout_width="129dp"
        android:layout_height="125dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_power"
        android:src="@drawable/button_power" />

    <ImageButton
        android:id="@+id/button_speed_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/button_speed_plus"
        android:layout_below="@id/button_power"
        android:layout_marginTop="16dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_speed_plus" />

    <ImageButton
        android:id="@+id/button_mode_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/button_mode_plus"
        android:layout_toEndOf="@id/button_mode_plus"
        android:layout_below="@id/button_power"
        android:layout_marginStart="16dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_mode_plus" />

    <ImageButton
        android:id="@+id/button_speed_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/button_speed_minus"
        android:layout_toEndOf="@id/button_mode_plus"
        android:layout_below="@id/button_power"
        android:layout_marginStart="16dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_speed_minus" />

    <ImageButton
        android:id="@+id/button_color_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_speed_plus"
        android:layout_marginTop="86dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_color_plus"
        android:src="@drawable/button_color_plus" />

    <ImageButton
        android:id="@+id/button_demo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/button_demo"
        android:layout_toEndOf="@id/button_color_plus"
        android:layout_below="@id/button_mode_plus"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_demo" />

    <ImageButton
        android:id="@+id/button_mode_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_speed_minus"
        android:layout_marginStart="-128dp"
        android:layout_marginTop="380dp"
        android:layout_toEndOf="@id/button_demo"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_mode_minus"
        android:src="@drawable/button_mode_minus" />

    <ImageButton
        android:id="@+id/button_color_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_color_plus"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_color_minus"
        android:src="@drawable/button_color_minus"
        tools:ignore="ImageContrastCheck" />

    <!-- Add color buttons here in a similar fashion -->

    <!-- Add the back button -->

    <ImageButton
        android:id="@+id/button_bright_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_demo"
        android:layout_marginStart="142dp"
        android:layout_marginTop="1dp"
        android:layout_toEndOf="@id/button_color_minus"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_bright_plus"
        android:src="@drawable/button_bright_plus" />

    <ImageButton
        android:id="@+id/button_bright_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_mode_minus"
        android:layout_marginStart="-267dp"
        android:layout_marginTop="170dp"
        android:layout_toEndOf="@id/button_bright_plus"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_bright_minus"
        android:src="@drawable/button_bright_minus" />

    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/button_back"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_back" />

</RelativeLayout>
