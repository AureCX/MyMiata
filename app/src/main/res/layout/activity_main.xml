<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Welcome message -->
    <TextView
        android:id="@+id/welcomeTextView"
        android:textColor="@android:color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_user"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="24sp"
        android:layout_marginTop="32dp"/>

    <!-- Car model and logo -->

    <TextView
        android:id="@+id/carModelTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="312dp"
        android:text="@string/my_miata"
        android:textColor="#FF0000"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeTextView"
        tools:ignore="VisualLintOverlap" />

    <ImageView
        android:id="@+id/carLogoImageView"
        android:layout_width="52dp"
        android:layout_height="32dp"
        android:layout_marginTop="32dp"
        android:contentDescription="@string/car_image_description"
        android:src="@drawable/mazda_logo"
        app:layout_constraintBottom_toTopOf="@+id/carImageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/carModelTextView"
        app:layout_constraintTop_toBottomOf="@+id/welcomeTextView"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="VisualLintBounds" />

    <ImageView
        android:id="@+id/carImageView"
        android:layout_width="411dp"
        android:layout_height="259dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/car_side_view_description"
        android:src="@drawable/miata_side_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/carModelTextView"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="VisualLintBounds" />

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/carImageView" />

    <!-- Bubble Menu -->

    <Button
        android:id="@+id/button"
        android:layout_width="108dp"
        android:layout_height="55dp"
        android:layout_marginTop="188dp"
        android:background="@android:color/transparent"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.462"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/welcomeTextView"
        tools:ignore="SpeakableTextPresentCheck"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/bubbleMenu"
        android:layout_width="160dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bubble_background"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/button"
        app:layout_constraintStart_toStartOf="@id/button"
        app:layout_constraintTop_toBottomOf="@id/button"
        tools:ignore="TextSizeCheck"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:ignore="UselessParent">
            <!-- Image inside the bubble menu -->
            <ImageView
                android:id="@+id/bubbleImage"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/plaque_vide"
                android:gravity="center"
                android:src="@drawable/plaque_francaise_vide" />

            <!-- Text zone inside the bubble menu -->
            <TextView
                android:id="@+id/licensePlateTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="3dp"
                android:layout_marginTop="1dp"
                android:background="#00000000"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/license_plate"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                tools:ignore="VisualLintBounds" />

        </FrameLayout>

    </LinearLayout>

    <Button
        android:id="@+id/irRemoteButton"
        android:layout_width="47dp"
        android:layout_height="50dp"
        android:layout_marginTop="100dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.076"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/carImageView"
        tools:ignore="HardcodedText,SpeakableTextPresentCheck,TextSizeCheck,TouchTargetSizeCheck" />
</androidx.constraintlayout.widget.ConstraintLayout>
