<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:visibility="visible"
    tools:context=".IRRemoteActivity">


    <ImageButton
        android:id="@+id/button_power"
        android:layout_width="175dp"
        android:layout_height="183dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_power"
        android:src="@drawable/button_power"
        android:visibility="visible" />

    <Button
        android:id="@+id/button_speed_plus"
        android:layout_width="101dp"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="250dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/button_speed_plus"
        android:text="@string/button_speed_plus"
        android:visibility="visible"
        android:backgroundTint="@android:color/darker_gray"/>

    <Button
        android:id="@+id/button_mode_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_power"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="145dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="125dp"
        android:backgroundTint="@android:color/darker_gray"
        android:contentDescription="@string/button_mode_plus"
        android:text="@string/button_mode_plus"
        android:visibility="visible"
        tools:ignore="VisualLintButtonSize" />

    <!-- Add color buttons here in a similar fashion -->

    <!-- Add the back button -->

    <Button
        android:id="@+id/button_speed_minus"
        android:layout_width="64dp"
        android:layout_height="50dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="250dp"
        android:layout_marginEnd="30dp"
        android:layout_toStartOf="@+id/button_demo"
        android:backgroundTint="@android:color/darker_gray"
        android:contentDescription="@string/button_speed_minus"
        android:text="@string/button_speed_minus"
        android:visibility="visible"
        tools:ignore="VisualLintButtonSize" />

    <Button
        android:id="@+id/button_color_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/button_speed_minus"
        android:layout_alignParentStart="true"
        android:layout_marginStart="25dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="-130dp"
        android:layout_toStartOf="@+id/button_mode_minus"
        android:backgroundTint="@android:color/darker_gray"
        android:contentDescription="@string/button_color_plus"
        android:text="@string/button_color_plus"
        android:visibility="visible"
        tools:ignore="RelativeOverlap" />

    <Button
        android:id="@+id/button_demo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_mode_plus"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="125dp"
        android:backgroundTint="@android:color/darker_gray"
        android:contentDescription="@string/button_demo"
        android:text="@string/button_demo"
        android:visibility="visible" />

    <Button
        android:id="@+id/button_mode_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/button_demo"
        android:layout_alignParentStart="true"
        android:layout_marginStart="150dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@android:color/darker_gray"
        android:contentDescription="@string/button_mode_minus"
        android:text="@string/button_mode_minus"
        android:visibility="visible" />

    <Button
        android:id="@+id/button_color_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_color_plus"
        android:layout_alignParentStart="true"
        android:layout_marginStart="30dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@android:color/darker_gray"
        android:contentDescription="@string/button_color_minus"
        android:text="@string/button_color_minus"
        android:visibility="visible" />

    <Button
        android:id="@+id/button_bright_plus"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/button_speed_plus"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="13dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="3dp"
        android:layout_toEndOf="@+id/button_mode_minus"
        android:backgroundTint="@android:color/darker_gray"
        android:contentDescription="@string/button_bright_plus"
        android:text="@string/button_bright_plus"
        android:visibility="visible"
        tools:ignore="VisualLintButtonSize" />

    <Button
        android:id="@+id/button_bright_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/button_bright_plus"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="9dp"
        android:backgroundTint="@android:color/darker_gray"
        android:contentDescription="@string/button_bright_minus"
        android:text="@string/button_bright_minus"
        android:visibility="visible" />

    <Button
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="66dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/button_back"
        android:text="@string/x"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="24sp"
        android:visibility="visible"
        tools:ignore="RelativeOverlap,TouchTargetSizeCheck" />

    <Button
        android:id="@+id/white_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/button_mode_minus"
        android:layout_marginStart="27dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:layout_toStartOf="@+id/button_bright_minus"
        android:layout_toEndOf="@+id/button_color_minus"
        android:backgroundTint="@android:color/white"
        android:outlineSpotShadowColor="@color/black"
        tools:ignore="VisualLintButtonSize,SpeakableTextPresentCheck" />

    <Button
        android:id="@+id/red_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/button_color_minus"
        android:layout_alignParentStart="true"
        android:layout_marginStart="30dp"
        android:layout_marginTop="17dp"
        android:backgroundTint="#ff0000"
        tools:ignore="SpeakableTextPresentCheck" />

    <Button
        android:id="@+id/green_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/white_button"
        android:layout_marginStart="30dp"
        android:layout_marginTop="17dp"
        android:layout_toEndOf="@+id/red_button"
        android:backgroundTint="@android:color/holo_green_dark"
        tools:ignore="SpeakableTextPresentCheck" />

    <Button
        android:id="@+id/dark_blue_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/button_bright_minus"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="25dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="15dp"
        android:layout_toEndOf="@+id/green_button"
        android:backgroundTint="#00008B"
        tools:ignore="VisualLintButtonSize,SpeakableTextPresentCheck" />

    <Button
        android:id="@+id/yellow_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/red_button"
        android:layout_alignParentStart="true"
        android:layout_marginStart="30dp"
        android:layout_marginTop="17dp"
        android:backgroundTint="#FFFF00"
        tools:ignore="SpeakableTextPresentCheck" />

    <Button
        android:id="@+id/ocean_blue_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/green_button"
        android:layout_marginStart="30dp"
        android:layout_marginTop="17dp"
        android:layout_toEndOf="@+id/yellow_button"
        android:backgroundTint="#009dc4"
        tools:ignore="SpeakableTextPresentCheck" />

    <Button
        android:id="@+id/purple_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/dark_blue_button"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="25dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="15dp"
        android:layout_toEndOf="@+id/ocean_blue_button"
        android:backgroundTint="#800080"
        tools:ignore="VisualLintButtonSize,SpeakableTextPresentCheck" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ocean_blue_button"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="5dp"
        android:layout_marginTop="74dp"
        android:layout_marginEnd="5dp"
        android:text="@string/infrared_remote"
        android:textSize="30sp"
        android:textColor="@android:color/black"
        android:gravity="center"/>

</RelativeLayout>
